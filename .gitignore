# Ignore build artifacts and temporary files

# object files, compiled binaries
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib
*.lo
*.la
*.out
*.pid
*.bin
*.csv
*.log
*.lzo
*.clbin*
*.baseline

# preprocessed/source-generated files
*.i
*.ii
pre*.i

# assembler, map
*.s
*.map

# editor/temp files
*~
*.tmp
*.bak
*.swp
*.log

# VS Code and local editor settings
.vscode/
*.code-workspace

# backup folder used during cleanups
lzo_cpu/backup/

# MinGW/MSYS dumps
*.exe.stackdump

# Ignore other common generated files
*.pyc
__pycache__/

# Local user build files
/.local-build/

# If there are specific build outputs in subdirs, add them explicitly
# e.g. ignore any lzo_cpu executables or preprocessed outputs
lzo_cpu/lzo_cpu

lzo_gpu/lzo_gpu
samples/
lzo_gpu/build_kernel
lzo_gpu/variant_validation/nvidia/
lzo_gpu/variant_validation/intel/
lzo_hybrid/variant_validation/nvidia/
lzo_hybrid/variant_validation/intel/
lzo_debug/

exp_results/
build/
archived/
lzo_hybrid/lzo_hybrid
# lzo_hybrid/*.cl
.cache
benchmark_bandwidth
*_debug.cl
lzo_gpu_v2/
*tmp*
# end
